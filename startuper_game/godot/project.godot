; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Мамкин Единорог"
config/description="Игра про стартапера по фамилии Мамкин. Еще со студенчества Мамкин грезил стать предпринимателем и вынашивал идею стартапа. И вот накопив стартовый капитал решился уйти из найма и начать свой собственный стартап. Ваша задача -- не дать Мамкину потерять все деньги, пройти три стадии развития стартапа: Построение продутка, Выявление соответствия продукта рынку и Масштабирование."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/size/min_width=1200
window/size/min_height=680

[rendering]

textures/canvas_textures/default_texture_repeat=1
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
